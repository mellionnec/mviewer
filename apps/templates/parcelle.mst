<div class="parcelle-fiche">
  {{#features}}
  <div class="parcelle">
    <h4><b>Parcelle {{parc}}</b></h4>
    <table class="table table-sm">
      <tr><td>Parcelle</td><td>{{parc}}</td></tr>
      <tr><td>Propriétaire</td><td>{{elag_nom_prop}}</td></tr>
      <tr><td>Adresse</td><td>{{elag_adresse_prop}}</td></tr>
    </table>
    <hr/>
    <div class="elag-cmt-block">
      Statut de la parcelle :
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="elag-st-p-{{parc}}" data-elag-status="proprio_ok" onchange="elagSetStatus('{{parc}}','proprio_ok',this)">
        <label class="form-check-label" for="elag-st-p-{{parc}}">Propriétaire OK</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="elag-st-v-{{parc}}" data-elag-status="visite" onchange="elagSetStatus('{{parc}}','visite',this)">
        <label class="form-check-label" for="elag-st-v-{{parc}}">Visite à programmer</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="elag-st-n-{{parc}}" data-elag-status="non_traite" onchange="elagSetStatus('{{parc}}','non_traite',this)">
        <label class="form-check-label" for="elag-st-n-{{parc}}">Non traité</label>
      </div>
      <div class="elag-status-msg" style="font-size:0.85em;color:#555"></div>
      <hr/>
      Commentaire partagé :
      <div id="elag-cmt-{{parc}}" class="elag-cmt-text">Cliquez sur Actualiser pour afficher le commentaire et le statut enregistrés.</div>
      <div style="margin-top:6px">
        <input type="text" class="elag-cmt-author form-control form-control-sm" placeholder="Votre nom" style="max-width:220px"/>
        <textarea class="elag-cmt-input form-control" rows="2" placeholder="Votre commentaire sur cette parcelle..."></textarea>
        <button type="button" class="btn btn-sm btn-info mt-1" onclick="elagShowComment('{{parc}}', this)">🔄 Actualiser</button>
        <button type="button" class="btn btn-sm btn-success mt-1" onclick="elagSaveComment('{{parc}}', this)">💾 Enregistrer</button>
        <span class="elag-cmt-status"></span>
      </div>
    </div>
  </div>
  {{/features}}
</div>
