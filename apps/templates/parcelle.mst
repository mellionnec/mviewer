<style>
/* Compatibilite mobile / tablette : police 16px pour eviter le zoom auto iOS,
   largeurs fluides, boutons sur une seule ligne tant que possible. */
.elag-cmt-block select,
.elag-cmt-block textarea { max-width: 100%; }
.elag-cmt-block .form-control { border-radius: 4px; }
@media (max-width: 767px) {
  .elag-cmt-block select,
  .elag-cmt-block textarea { font-size: 16px; }
  .elag-cmt-block .btn { padding: 6px 10px; }
}
</style>
<div class="parcelle-fiche">
  {{#features}}
  <div class="parcelle">
    <h4><b>Parcelle {{parc}}</b></h4>
    <table class="table table-sm">
      <tr><td>Parcelle</td><td>{{parc}}</td></tr>
      <tr><td>Propriétaire</td><td>{{elag_nom_prop}}</td></tr>
      <tr><td>Adresse</td><td>{{elag_adresse_prop}}</td></tr>
    </table>
    <hr/>
    <div class="elag-cmt-block">
      Statut de la parcelle :
      <select class="form-control form-control-sm" id="elag-st-{{parc}}" data-elag-status-select
              style="width:100%;max-width:260px" onchange="elagSetStatus('{{parc}}', this.value, this)">
        <option value="">— Aucun statut —</option>
        <option value="proprio_ok" style="background-color:#009900;color:#fff;font-weight:bold">Propriétaire OK</option>
        <option value="visite" style="background-color:#FF8C00;color:#fff;font-weight:bold">Visite à programmer</option>
        <option value="non_traite" style="background-color:#FF0000;color:#fff;font-weight:bold">Propriétaire NON</option>
      </select>
      <div class="elag-status-msg" style="font-size:0.85em;color:#555"></div>
      <hr/>
      Commentaire partagé :
      <div id="elag-cmt-{{parc}}" class="elag-cmt-text">Cliquez sur Actualiser pour afficher le commentaire et le statut enregistrés.</div>
      <div style="margin-top:6px">
        <select class="elag-cmt-author form-control form-control-sm" style="width:100%;max-width:220px">
          <option value="">Votre nom…</option>
          <option value="pyd">pyd</option>
          <option value="cc">cc</option>
          <option value="fr">fr</option>
          <option value="fg">fg</option>
        </select>
        <textarea class="elag-cmt-input form-control" rows="2" placeholder="Votre commentaire sur cette parcelle..."></textarea>
        <button type="button" class="btn btn-sm btn-info mt-1" onclick="elagShowComment('{{parc}}', this)">🔄 Actualiser</button>
        <button type="button" class="btn btn-sm btn-success mt-1" onclick="elagSaveComment('{{parc}}', this)">💾 Enregistrer</button>
        <span class="elag-cmt-status"></span>
      </div>
    </div>
  </div>
  {{/features}}
</div>
