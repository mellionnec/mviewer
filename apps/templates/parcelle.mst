<div class="parcelle-fiche">
  {{#features}}
  <div class="parcelle">
    <h4><b>Parcelle {{parc}}</b></h4>
    <table class="table table-sm">
      <tr><td><b>Code INSEE</b></td><td>{{commune}}</td></tr>
      <tr><td><b>Contenance</b></td><td>{{contenance}} m2</td></tr>
      <tr><td><b>Arpentée</b></td><td>{{arpente}}</td></tr>
      <tr><td><b>Créée le</b></td><td>{{created}}</td></tr>
      <tr><td><b>Mise à jour</b></td><td>{{updated}}</td></tr>
      <tr><td><b>Propriétaire</b></td><td>{{elag_nom_prop}}</td></tr>
      <tr><td><b>Adresse propriétaire</b></td><td>{{elag_adresse_prop}}</td></tr>
      <tr><td><b>Note d'origine</b></td><td>{{elag_commentaire}}</td></tr>
    </table>
    <hr/>
    <div class="elag-cmt-block">
      <b>💬 Commentaire partagé :</b>
      <div id="elag-cmt-{{parc}}" class="elag-cmt-text">Cliquez sur « Voir » pour afficher le dernier commentaire enregistré.</div>
      <div style="margin-top:6px">
        <input type="text" class="elag-cmt-author form-control form-control-sm" placeholder="Votre nom (optionnel)" style="max-width:220px"/>
        <textarea class="elag-cmt-input form-control" rows="2" placeholder="Votre commentaire sur cette parcelle..."></textarea>
        <button type="button" class="btn btn-sm btn-info mt-1" onclick="elagShowComment('{{parc}}', this)">👁 Voir</button>
        <button type="button" class="btn btn-sm btn-success mt-1" onclick="elagSaveComment('{{parc}}', this)">💾 Enregistrer</button>
        <span class="elag-cmt-status"></span>
      </div>
    </div>
  </div>
  {{/features}}
</div>
