                metadata="https://geobretagne.fr/datahub/dataset/f33ce68d-9643-4db1-a5e7-745896d5b25a" legendurl="https://geobretagne.fr/geoserver/rectorat/ows?SERVICE=WMS&amp;VERSION=1.3.0&amp;REQUEST=GetLegendGraphic&amp;SLD_VERSION=1.1.0&amp;FORMAT=image/png&amp;TRANSPARENT=true&amp;LAYER=etablissements_scolaire&amp;STYLE="
                url="https://geobretagne.fr/apps/macommune/customlayers/etablissement_scolaire.js">
                <template url="https://geobretagne.fr/apps/macommune/templates/etablissement_scolaire.mst"/>
            </layer>
            <layer id="culture" name="Equipements culturels" visible="true" tiled="false"
