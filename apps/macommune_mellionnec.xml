<?xml version="1.0" encoding="UTF-8"?>
<config>
    <application
        title="Mellionnec - Ma commune"
        showhelp="false"
        measuretools="true"
        zoomtools="true"
        initialextenttool="true"
        coordinates="false"
        geoloc="true"
        lang="fr"
        templaterightinfopanel="brut"
        togglealllayersfromtheme="false"/>

    <mapoptions
        projection="EPSG:3857"
        center="-366907,6134858"
        zoom="13"
        maxzoom="20"/>

    <olscompletion type="ban" url="https://api-adresse.data.gouv.fr/search/" attribution="Base adresse nationale (BAN)"/>
    <searchparameters bbox="true" localities="true" features="true" static="false" querymaponclick="true" closeafterclick="true" inputlabel="Rechercher" searchmaxzoomlevel="18"/>

    <extensions>
        <extension type="javascript" src="/apps/macommune/config/configuration.js"/>
        <extension type="javascript" src="https://cdn.jsdelivr.net/gh/mellionnec/mviewer@c426d764f9a0e6b64d36295eba57d28de07dcb74/apps/js/macommune-siren.js"/>
    </extensions>

    <baselayers style="gallery">
        <baselayer visible="true" id="osm_faded" thumbgallery="https://tile.geobretagne.fr/osm/tms/osm:faded/EPSG3857/16/64287/85957.png" title="OpenStreetMap Faded" label="OpenStreetMap Faded" type="WMTS"
            url="https://tile.geobretagne.fr/osm/service" layers="osm:faded" attributioncollapsible="false" format="image/png" matrixset="PM" fromcapacity="false" style="_null"
            attribution="GéoBretagne. Données : les contributeurs d'OpenStreetMap, ODbL"/>
        <baselayer visible="false" id="osm1" type="OSM" label="OpenStreetMap" title="OpenStreetMap" thumbgallery="img/basemap/osm.png"
            url="https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png"
            attribution="les contributeurs d'OpenStreetMap, ODbL"/>
        <baselayer visible="false" id="planignv2" type="WMTS" label="Plan IGN v2" title="Plan IGN v2"
            url="https://data.geopf.fr/wmts" layers="GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2" format="image/png"
            style="normal" matrixset="PM" fromcapacity="false" maxzoom="19"
            attribution="IGN, Géoportail"/>
        <baselayer visible="false" id="ortho1" type="WMTS" label="Photo aérienne IGN" title="Géoportail"
            url="https://data.geopf.fr/wmts" layers="ORTHOIMAGERY.ORTHOPHOTOS" format="image/jpeg"
            style="normal" matrixset="PM" fromcapacity="false" maxzoom="22"
            attribution="IGN, Géoportail"/>
    </baselayers>

    <themes mini="false">
        <theme id="admin" name="Administrations" collapsed="false" icon="fas fa-caret-right">
            <layer id="territoire"
                name="Contour de la commune"
                type="customlayer"
                vectorlegend="false"
                url="https://geobretagne.fr/apps/macommune/customlayers/territoire.js"
                queryable="false"
                visible="true"
                showintoc="false"
                attribution="GéoBretagne, IGN"/>
            <layer id="administration" name="Administrations"
                visible="true" tiled="false" queryable="true"
                type="customlayer"
                vectorlegend="false" dynamiclegend="true"
                searchable="true" searchengine="fuse" fusesearchkeys="nom" fusesearchresult="{{nom}}" fusesearchthreshold="0.3"
                attribution="API de l'annuaire des services publics" legendurl="https://ows.region-bretagne.fr/geoserver/rb/ows?SERVICE=WMS&amp;VERSION=1.3.0&amp;REQUEST=GetLegendGraphic&amp;SLD_VERSION=1.1.0&amp;FORMAT=image/png&amp;TRANSPARENT=true&amp;LAYER=administration&amp;STYLE=administration_ma_commune"
                metadata="https://geobretagne.fr/datahub/dataset/b543ad35-966b-4bea-ad0d-ff03ce254914"
                url="https://geobretagne.fr/apps/macommune/customlayers/administration.js">
                <template url="https://geobretagne.fr/apps/macommune/templates/administration.mst"></template>
            </layer>
        </theme>

        <theme id="equipement" name="Equipements" collapsed="true" icon="fas fa-caret-right">
            <layer id="etablissement_scolaire" name="Etablissements scolaires" visible="true" tiled="false"
