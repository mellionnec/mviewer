                url="https://geobretagne.fr/apps/macommune/customlayers/culture.js">
                <template url="https://geobretagne.fr/apps/macommune/templates/culture.mst"/>
            </layer>
            <layer id="sport" name="Equipements sportifs" visible="true" tiled="false"
                queryable="true" type="customlayer" vectorlegend="false" attribution="Ministère des sports" dynamiclegend="true"
                searchable="true" searchengine="fuse" fusesearchkeys="inst_nom,equip_type_name" fusesearchresult="{{inst_nom}}" fusesearchthreshold="0.3"
                metadata="https://geobretagne.fr/datahub/dataset/00c57e00-ee57-4e13-93d0-3f98b32004b9" legendurl="https://geobretagne.fr/geoserver/opendata/ows?SERVICE=WMS&amp;VERSION=1.3.0&amp;REQUEST=GetLegendGraphic&amp;SLD_VERSION=1.1.0&amp;FORMAT=image/png&amp;TRANSPARENT=true&amp;LAYER=equipement_sportif&amp;STYLE=equipement_sportif_ma_commune"
                url="https://geobretagne.fr/apps/macommune/customlayers/sport.js">
                <template url="https://geobretagne.fr/apps/macommune/templates/sport.mst"/>
            </layer>
        </theme>

        <theme id="services" name="Services" collapsed="true" icon="fas fa-caret-right">
