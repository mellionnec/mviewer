<?xml version="1.0" encoding="UTF-8"?>
<config>
    <application
        title="Parcelles ELAG Mellionnec"
        showhelp="false"
        measuretools="true"
        zoomtools="true"
        initialextenttool="true"
        coordinates="false"
        lang="fr"/>

    <mapoptions
        projection="EPSG:3857"
        center="-366907,6134858"
        zoom="13"
        maxzoom="19"/>

    <olscompletion url="https://data.geopf.fr/geocodage/completion" type="completion" attribution="Service d'autocomplétion de l'IGN"/>
    <searchparameters localities="true" features="true" bbox="false" static="false"/>

    <extensions>
        <extension type="javascript" src="https://cdn.jsdelivr.net/gh/mellionnec/mviewer@0170387dec2d5dc30e3f13a42886ac76b860d1b1/apps/js/elag-comments.js"/>
    </extensions>

    <baselayers style="default">
        <baselayer
            type="OSM"
            id="osm"
            label="OpenStreetMap"
            title="OpenStreetMap"
            url="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
            format="image/png"
            visible="true"
            attribution="© OpenStreetMap contributors"/>
        <baselayer
            type="WMTS"
            id="planignv2"
            label="Plan IGN v2"
            title="Plan IGN v2"
            url="https://data.geopf.fr/wmts"
            layers="GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2"
            format="image/png"
            style="normal"
            matrixset="PM"
            fromcapacity="false"
            visible="false"
            maxzoom="19"
            attribution="IGN, Géoportail"/>
        <baselayer
            type="WMTS"
            id="ortho"
            label="Photo aérienne IGN"
            title="GéoPortail"
            url="https://data.geopf.fr/wmts"
            layers="ORTHOIMAGERY.ORTHOPHOTOS"
            format="image/jpeg"
            style="normal"
            matrixset="PM"
            fromcapacity="false"
            visible="false"
            maxzoom="22"
            attribution="IGN, Géoportail"/>
    </baselayers>

    <themes>
        <theme
            id="elag"
            name="Parcelles ELAG"
            collapsed="false"
            icon="fas fa-leaf">
            <layer
                id="parc_statuts"
                type="customlayer"
                name="Statuts des parcelles"
                url="https://cdn.jsdelivr.net/gh/mellionnec/mviewer@25a3a7b6c9ff7a47ca549851ed606b0c9115703d/apps/customlayers/parc_statuts.js"
                visible="true"
                queryable="false"
                vectorlegend="true"
                attribution="Statuts saisis dans la table Grist"/>
            <layer
                id="parc_elag"
                type="geojson"
                name="Parcelles ELAG (75)"
                url="https://raw.githubusercontent.com/mellionnec/mviewer/main/parc_elag.geojson"
                visible="true"
                queryable="true"
                style="highlight"
                vectorlegend="true"
                searchable="true"
                searchengine="fuse"
                fusesearchkeys="parc,elag_nom_prop,elag_commentaire"
                fusesearchresult="{{parc}} - {{elag_nom_prop}}"
                tooltip="true"
                tooltipenabled="true"
                tooltipcontent="{{parc}} - {{elag_nom_prop}}"
                attribution="Données ELAG, Mellionnec et alentours (Côtes-d'Armor)">
                <template url="https://cdn.jsdelivr.net/gh/mellionnec/mviewer@25a3a7b6c9ff7a47ca549851ed606b0c9115703d/apps/templates/parcelle.mst"/>
            </layer>
            <layer
                id="vc_cr"
                type="customlayer"
                name="Voies communales et chemins ruraux"
                url="https://cdn.jsdelivr.net/gh/mellionnec/mviewer@c6773fdd66e8951cb271556e46c06fb6cba604d0/apps/customlayers/vc_cr.js"
                visible="false"
                queryable="false"
                vectorlegend="true"
                attribution="Voirie communale et rurale, commune de Mellionnec"/>
        </theme>
    </themes>
</config>
